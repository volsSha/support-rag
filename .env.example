JWT_SECRET=change-me-to-a-256-bit-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DEBUG=true
APP_NAME=Support RAG
APP_URL=http://localhost:8080

OPENROUTER__API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER__DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER__MAX_TOKENS=2048
OPENROUTER__TEMPERATURE=0.3

EMBEDDING__MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING__DIMENSIONS=384
EMBEDDING__BATCH_SIZE=32

DATABASE__URL=sqlite+aiosqlite:///data/app.db

REDIS__URL=redis://localhost:6379/0

RATE_LIMIT__REQUESTS_PER_MINUTE=30
RATE_LIMIT__REQUESTS_PER_HOUR=200

SEED__ADMIN_USERNAME=admin
SEED__ADMIN_PASSWORD=admin123
SEED__ADMIN_EMAIL=admin@example.com

RERANKER__MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER__TOP_K=20
RERANKER__TOP_N=5

RETRIEVAL__SIMILARITY_THRESHOLD=0.7
RETRIEVAL__CONTEXT_MAX_TOKENS=3000
